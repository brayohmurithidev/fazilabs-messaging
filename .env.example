APP_NAME="Fazilabs Messaging Platform"
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql+asyncpg://messaging_user:replace-with-local-password@localhost:5432/fazilabs_messaging
# Test commands read this separately and require an isolated database name containing "test".
APP_TEST_DATABASE_URL=postgresql+asyncpg://messaging_test_user:replace-with-test-password@localhost:5432/fazilabs_messaging_test
APP_WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token
APP_WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
APP_WHATSAPP_ACCESS_TOKEN=replace-with-your-whatsapp-access-token
APP_WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
APP_WHATSAPP_API_VERSION=v26.0
APP_PUBLIC_WEBHOOK_BASE_URL=
APP_ADVANTA_BASE_URL=https://example.invalid
APP_ADVANTA_API_KEY=replace-with-your-advanta-api-key
APP_ADVANTA_PARTNER_ID=replace-with-your-advanta-partner-id
APP_ADVANTA_SENDER_ID=FAZILABS
APP_ADVANTA_PROVIDER_COST_PER_PAGE_MINOR=20
APP_BILLING_UNCERTAIN_RECONCILE_AFTER_MINUTES=1440
