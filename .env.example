APP_NAME="Fazilabs Messaging Platform"
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_agent
APP_WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token
APP_WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
APP_WHATSAPP_ACCESS_TOKEN=replace-with-your-whatsapp-access-token
APP_WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
APP_WHATSAPP_API_VERSION=v26.0
APP_PUBLIC_WEBHOOK_BASE_URL=
APP_BILLING_UNCERTAIN_RECONCILE_AFTER_MINUTES=1440
